{
  "name": "commerce-starter",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @store/backend exec medusa db:migrate",
    "seed": "node scripts/seed.mjs",
    "user:create": "pnpm --filter @store/backend exec medusa user",
    "test": "pnpm --filter @store/backend test:integration:http",
    "test:smoke": "node --test tests/",
    "test:acceptance": "bash scripts/acceptance.sh",
    "backend:dev": "turbo dev --filter=@store/backend",
    "storefront:dev": "turbo dev --filter=@store/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.7",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
