# Production environment for deploy/docker-compose.prod.yml.
#   cp deploy/.env.production.example deploy/.env.production
# Keep deploy/.env.production out of git (already ignored) and readable only by the deploy user.

# --- Public addresses ---------------------------------------------------------
STOREFRONT_DOMAIN=shop.example.com
BACKEND_DOMAIN=api.example.com
STOREFRONT_URL=https://shop.example.com
BACKEND_URL=https://api.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets (generate each with: openssl rand -hex 32) -----------------------
POSTGRES_USER=medusa
# Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=medusa
JWT_SECRET=
COOKIE_SECRET=

# --- Storefront build arguments (rebuild the storefront image after changes) --
# Printed by the minimal seed: docker compose ... run --rm server node_modules/.bin/medusa exec ./src/scripts/seed.js minimal
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=de
NEXT_PUBLIC_STRIPE_KEY=

# --- Media storage --------------------------------------------------------------
# Empty S3_BUCKET: uploads go to the "uploads" volume, served at BACKEND_URL/static.
# AWS S3 / R2 / Spaces / any S3-compatible service: fill these in.
# Bundled SeaweedFS (--profile s3): S3_BUCKET=media  S3_ENDPOINT=http://s3:8333
#   S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=true  S3_FILE_URL=https://media.example.com/media
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: choose random values; enable the media site in Caddyfile.
S3_BUCKET=
S3_FILE_URL=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Payments (optional) --------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Image names (optional, e.g. when pushing to a registry) --------------------
# BACKEND_IMAGE=registry.example.com/store/backend:1.0.0
# STOREFRONT_IMAGE=registry.example.com/store/storefront:1.0.0
