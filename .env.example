# Local development environment. Copy to .env:  cp .env.example .env
# One file serves docker-compose.yml, the Medusa backend and the Next.js storefront.
# Never commit .env. Production uses deploy/.env.production (see deploy/.env.production.example).

# --- Infrastructure (docker-compose.yml) ------------------------------------
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Backend (apps/backend) -------------------------------------------------
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379
# Development-only secrets. Production refuses to start with these values.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173
# Public URL of the backend, used by Medusa Admin.
MEDUSA_BACKEND_URL=http://localhost:9000

# Optional: S3-compatible media storage. Leave S3_BUCKET empty to store uploads locally.
S3_BUCKET=
S3_FILE_URL=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional: Stripe. Leave empty to use only the built-in test payment provider.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storefront (apps/storefront) -------------------------------------------
# NEXT_PUBLIC_* values are inlined at build time (`next build`).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Written automatically by `npm run seed` when empty.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# ISO-2 country code of a country in a seeded region (lowercase).
NEXT_PUBLIC_DEFAULT_REGION=de
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Optional: Stripe publishable key (pairs with STRIPE_API_KEY).
NEXT_PUBLIC_STRIPE_KEY=

# --- Backend integration tests (npm test) -------------------------------------
# The test runner creates and drops its own database on this server.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medusa
DB_PASSWORD=medusa
